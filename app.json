{
  "expo": {
    "name": "FarmTori",
    "slug": "farmtori",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "farmtori",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D221A",
    "primaryColor": "#15803D",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D221A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmtori.app",
      "userInterfaceStyle": "dark",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0D221A"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "FarmTori requires camera access for farm photography and QR code traceability scanning.",
        "NSLocationWhenInUseUsageDescription": "FarmTori requires location permissions to record precise GPS coordinates for farm boundaries and field visits.",
        "NSPhotoLibraryUsageDescription": "FarmTori needs photo library access to upload farm, crop, and inspection evidence photos.",
        "NSMicrophoneUsageDescription": "FarmTori uses the microphone so you can record a spoken note about your season."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D221A"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0D221A"
      },
      "package": "com.farmtori.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D221A",
          "image": "./assets/splash.png",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0D221A"
          },
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "FarmTori uses the microphone so you can record a spoken note about your season."
        }
      ],
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CropCapture to use camera for farm and quality inspection photography."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CropCapture to capture farm GPS coordinates."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

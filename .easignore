# Files EAS Build does NOT upload. When this file exists EAS uses it INSTEAD of .gitignore, so the
# .gitignore patterns are repeated here. The phone app does not need the admin site, the USSD server,
# the database scripts or the tests, and leaving them out keeps the upload small (the admin build
# folders alone are hundreds of MB).

# same as .gitignore
node_modules/
.expo/
dist/
web-build/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.env*.local
.env
expo-env.d.ts

# not part of the phone app
.git/
admin/
server/
supabase/
__tests__/
docs/
scripts/
render.yaml
presentation_slides.html
*.log
*.tsbuildinfo
.next/
**/.next/
*.pptx
*.pdf
*.py
